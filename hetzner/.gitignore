# Never commit anything in here: hcloud API token, deployment SSH keypair, CA bundle, server.json
.secrets/

# Generated by provision.sh, contains all production secrets.
# .env.* also covers .env.local, used for the local smoke test - note that the repo-level
# "*.env" rule does NOT match these, since they end in .local rather than .env.
.env
.env.*
!.env.example
